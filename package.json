{
  "name": "bughunter-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:network": "SCANNER_HTTP_TESTS=1 vitest run tests/network",
    "test:ui": "npm run build && node tests/queue/runInfrastructure.mjs --target-browser",
    "test:targets:recon": "node tests/recon/runAssetTools.mjs",
    "test:migration": "node tests/migrations/programUpgrade.mjs",
    "worker": "tsx src/server/queue/worker.ts",
    "user:create": "node scripts/create-user.mjs",
    "policy:backfill": "tsx scripts/backfill-execution-policies.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test:queue": "node tests/queue/runInfrastructure.mjs",
    "test:auth": "node tests/queue/runInfrastructure.mjs --auth-browser",
    "test:research": "node tests/research/runInfrastructure.mjs && npm run test:research:console",
    "test:research:final": "node --import tsx tests/e2e/researchFinal.mjs",
    "test:research:mcp-rebuild": "node tests/research/mcpRebuild.mjs",
    "test:research:recon": "tsx tests/research/reconDelivery.mts",
    "test:research:console": "node --import tsx tests/research/runConsole.mjs",
    "recon:doctor": "tsx scripts/recon/doctor.mts",
    "test:recon:toolchain": "node tests/recon/runToolchain.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.18",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pino": "^10.4.0",
    "playwright-chromium": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "ws": "8.22.0"
  },
  "overrides": {
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
