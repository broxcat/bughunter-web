// Explicit opt-in: one real native Codex inference, synthetic context only.
// Runs the same --yolo mode as the product inside its non-root isolated console.
// The task permits only reading its own synthetic files, no test or network execution.
// Existing credentials are used inside the running Research console, never copied.
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {coverageMarkdown,coverageCounts,type CoverageEntry,type CoverageView} from '../../src/lib/research/coverage';
assert.equal(process.env.BH_REAL_CODEX_COVERAGE,'1','Explicit paid/native acceptance opt-in required');
const base={id:'synthetic-get',revision:1,objectiveKey:'authorization-orders',surface:'https://coverage.example.test/api/orders/owned-object',contextLabel:'User A',contextKey:'AUTH_A',comparisonLabel:'User B',comparisonKey:'AUTH_B',contextRunId:'synthetic-recon',testKey:'object-authorization',events:[{result:'403 with the owned-object negative control; rejected hypothesis retained',createdAt:new Date().toISOString()}]} as CoverageEntry;
const entries=[{...base,method:'GET',state:'COVERED_NO_ISSUE_OBSERVED'},{...base,id:'synthetic-patch',method:'PATCH',state:'NOT_TESTED',events:[]}] as CoverageEntry[];
const view:CoverageView={version:1,targetId:'synthetic-target',planId:'synthetic-plan',contextRunId:'synthetic-recon',sessionId:'synthetic-session',notice:'Synthetic observations only. COVERED_NO_ISSUE_OBSERVED is not SAFE. No network activity authorized in this acceptance.',truncated:false,entries,objectives:[],counts:coverageCounts(entries,0)};
const schema={type:'object',properties:{repeatGet:{type:'boolean'},plannedNextMethod:{type:'string',enum:['GET','HEAD','POST','PUT','PATCH','DELETE','OPTIONS','NONE']},executeNow:{type:'boolean'},untestedMethods:{type:'array',items:{type:'string',enum:['GET','HEAD','POST','PUT','PATCH','DELETE','OPTIONS']}},context:{type:'string'},coverageProvesSafety:{type:'boolean'}},required:['repeatGet','plannedNextMethod','executeNow','untestedMethods','context','coverageProvesSafety'],additionalProperties:false};
const input={snapshot:view,markdown:coverageMarkdown(view),schema};
const script=`
import {mkdtemp,mkdir,writeFile,readFile,rm} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join} from 'node:path';import {spawnSync} from 'node:child_process';
const input=${JSON.stringify(input)},root=await mkdtemp(join(tmpdir(),'bh-native-coverage-'));let result;
try{await mkdir(join(root,'research'),{mode:0o700});for(const [name,data]of Object.entries({'coverage-current.json':JSON.stringify({version:1,jsonPath:'research/coverage-fixture.json',markdownPath:'research/coverage-fixture.md'}),'coverage-fixture.json':JSON.stringify(input.snapshot),'coverage-fixture.md':input.markdown}))await writeFile(join(root,'research',name),data,{mode:0o600});await writeFile(join(root,'output.schema.json'),JSON.stringify(input.schema),{mode:0o600});
const started=Date.now(),run=spawnSync('codex',['exec','--ephemeral','--skip-git-repo-check','--dangerously-bypass-approvals-and-sandbox','-c','mcp_servers={}','--json','--output-schema',join(root,'output.schema.json'),'--output-last-message',join(root,'answer.json'),'-C',root,'-'],{input:'This is a black-box Research context-memory acceptance using synthetic observations. Read research/coverage-current.json and the referenced immutable coverage files. For the recorded account comparison, choose which HTTP method the researcher should plan to examine next after confirming current authorization, and whether the equivalent completed GET needs to be repeated. This asks for a future test plan, not permission to execute it. executeNow must reflect that this acceptance authorizes no network execution. List the HTTP methods explicitly recorded NOT_TESTED in untestedMethods, independently of whether network execution is currently authorized. State whether the recorded coverage proves safety. Do not perform tests, make network requests, access other files, create Findings or change anything. Return only the requested JSON. Explain the account comparison in the context field.',encoding:'utf8',timeout:180000,maxBuffer:4*1024*1024});
let answer;try{answer=JSON.parse(await readFile(join(root,'answer.json'),'utf8'));}catch{}
const events=String(run.stdout).split('\\n').flatMap(line=>{try{return[JSON.parse(line)];}catch{return[];}}),commands=events.filter(e=>e.type==='item.completed'&&e.item?.type==='command_execution');
result={acceptance:'real-codex-coverage',exitCode:run.status,durationMs:Date.now()-started,nativeReadCommands:commands.length,commandFailures:commands.filter(e=>e.item?.exit_code!==0).length,repeatGet:answer?.repeatGet,plannedNextMethod:answer?.plannedNextMethod,executeNow:answer?.executeNow,untestedMethods:answer?.untestedMethods,coverageProvesSafety:answer?.coverageProvesSafety,answer,syntheticEvidence:true,realModelInference:true,success:run.status===0&&commands.length>0&&commands.every(e=>e.item?.exit_code===0)&&answer?.repeatGet===false&&answer?.untestedMethods?.includes('PATCH')&&answer?.executeNow===false&&['PATCH','NONE'].includes(answer?.plannedNextMethod)&&answer?.coverageProvesSafety===false&&/A.*B|User A/i.test(answer?.context??'')};
}finally{await rm(root,{recursive:true,force:true});}
console.log(JSON.stringify(result));if(!result?.success)process.exitCode=1;
`;
const run=spawnSync('docker',['compose','exec','-T','-u','researcher','research-console','node','--input-type=module'],{input:script,encoding:'utf8',timeout:200000,maxBuffer:1024*1024});
let result:Record<string,unknown>;try{result=JSON.parse(run.stdout.trim());}catch{throw new Error('Native Codex acceptance returned no safe metadata');}
// Withhold free model prose and provider error bodies, even on failure.
const {answer,...metadata}=result;console.log(JSON.stringify({...metadata,contextUnderstood:Boolean(answer&&typeof answer==='object'&&/A.*B|User A/i.test(String((answer as {context?:string}).context)))}));
assert.equal(run.status,0,'Real native Codex failed; raw provider output was withheld');
assert.equal(result.success,true,'Real Codex did not respect the persisted coverage context');
