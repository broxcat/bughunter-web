# Keep the build context small and avoid clobbering image-built artifacts.
node_modules
.next
out
build
coverage

# VCS + local env
.git
.gitignore
.env
.env.*
!.env.example

# Docker own files (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
docker/volumes

# Local data volumes (if ever created on host)
pgdata
redisdata

# Logs / debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS cruft
.DS_Store
.vercel
*.tsbuildinfo

# Docs — not needed for the build
*.md
