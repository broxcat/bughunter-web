# bughunter-web — environment contract (shared).
# Copy to .env and fill in. Docker agent may ADD vars below; never remove one
# another agent relies on without noting it.

# --- Database (Postgres) ---
# docker-compose default: host is the service name `db`. For non-docker local
# dev (npm run dev), change the host to `localhost`.
DATABASE_URL="postgresql://bughunter:bughunter@db:5432/bughunter?schema=public"

# Postgres container credentials (used by the `db` service AND must match the
# user/password/dbname in DATABASE_URL above).
POSTGRES_USER="bughunter"
POSTGRES_PASSWORD="bughunter"
POSTGRES_DB="bughunter"

# --- Redis (BullMQ queue + log pub/sub) ---
# docker-compose default: host is the service name `redis`. For non-docker local
# dev (npm run dev), change the host to `localhost`.
REDIS_URL="redis://redis:6379"
# Maximum concurrent Target-wide Recon campaigns (1–100), across workers.
TARGET_CAMPAIGN_MAX_ACTIVE=3

# --- Auth.js (NextAuth v5) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Required by Docker Compose: set to the browser-visible origin (scheme + host
# + optional port), e.g. http://100.64.0.1:3000 for the dedicated Tailscale node.
# Run `docker compose exec tailscale tailscale ip -4` to find its address.
# Auth.js gives this
# value priority over Host / X-Forwarded-Host / X-Forwarded-Proto.
AUTH_URL=""
# Compose publishes no host ports. Access is through its dedicated Tailscale
# node, enrolled with authkey_tailscale.txt (a local secret, never an env var).

# Public registration is opt-in (also gates new OAuth accounts). Existing
# accounts can still sign in. Bootstrap privately with `npm run user:create`.
ALLOW_PUBLIC_REGISTRATION=false
# Ignore all forwarded IP headers by default. Next.js has no trusted socket IP;
# unknown clients share one IP quota. Enable only behind an exclusive trusted
# ingress that overwrites/appends the actual peer, with NO untrusted direct path.
TRUST_PROXY_HEADERS=false
# Count trusted ingress proxies from the RIGHT of X-Forwarded-For (1–16).
# AUTH_URL does not enable this trust.
TRUSTED_PROXY_HOPS=1

# --- Credentials encryption (AES-256-GCM) for stored secrets ---
# MUST be 32 bytes, hex-encoded (64 hex chars). Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=""
# Set a new ID when rotating the key. Keep the old key in this JSON object.
# Keep the current ID as primary on existing installations until rotating, or set
# the legacy ID to the ID of the key that encrypted the unversioned records.
# CREDENTIALS_ENCRYPTION_KEY_ID="primary"
# CREDENTIALS_ENCRYPTION_LEGACY_KEY_ID="primary"
# CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS='{}'

# --- OOB catcher (Phase 5: out-of-band blind-SSRF confirmation) ---
# Base URL the SCANNED TARGET must be able to reach to hit the catcher (which
# is reachable on the dedicated Tailscale node's port 8089). The injected SSRF
# callback is built from this. Targets outside the tailnet need a separate catcher.
# MUST be an address reachable FROM THE TARGET, not just the worker — e.g. the
# operator-owned callback service. Without explicit configuration, Hunt skips
# OOB confirmation. No implicit loopback fallback or metadata/LAN probing.
OOB_PUBLIC_BASE_URL=""

# --- Optional OAuth providers (app boots fine without these) ---
# GITHUB_ID=""
# GITHUB_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Identification for Target execution. Program User-Agent takes precedence.
DEFAULT_USER_AGENT=
# Replaces username placeholders in program headers and User-Agent.
HUNTER_USERNAME=

# Trusted Ollama service for the Research semantic memory (reachable from web).
# RESEARCH_EMBEDDING_URL=http://host.docker.internal:11434
# RESEARCH_EMBEDDING_MODEL=embeddinggemma
