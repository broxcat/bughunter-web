# bughunter-web — environment contract (shared).
# Copy to .env and fill in. Docker agent may ADD vars below; never remove one
# another agent relies on without noting it.

# --- Database (Postgres) ---
# In docker-compose the host is the service name `db`.
DATABASE_URL="postgresql://bughunter:bughunter@localhost:5432/bughunter?schema=public"

# --- Redis (BullMQ queue + log pub/sub) ---
# In docker-compose the host is the service name `redis`.
REDIS_URL="redis://localhost:6379"

# --- Auth.js (NextAuth v5) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of the app.
AUTH_URL="http://localhost:3000"

# --- Credentials encryption (AES-256-GCM) for stored AI provider API keys ---
# MUST be 32 bytes, hex-encoded (64 hex chars). Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=""

# --- Optional OAuth providers (app boots fine without these) ---
# GITHUB_ID=""
# GITHUB_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
