#!/bin/sh
set -eu
umask 027
# Public keys only. Copy to root-owned config; never make a private host key readable.
test -f /run/research-keys/authorized_keys || { echo 'Set up data/research/authorized_keys first' >&2; exit 1; }
install -o root -g root -m 0644 /run/research-keys/authorized_keys /etc/ssh/authorized_keys
if [ ! -f /etc/ssh/host-keys/ssh_host_ed25519_key ]; then
  ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/host-keys/ssh_host_ed25519_key
fi
chmod 0700 /etc/ssh/host-keys
chmod 0600 /etc/ssh/host-keys/ssh_host_ed25519_key
# Named volumes start with the image's UID/GID and modes. No recursive chown of research data.
chown researcher:research /home/researcher/.codex
su -s /bin/sh researcher -c 'chmod 0700 /home/researcher/.codex'
exec /usr/sbin/sshd -D -e
