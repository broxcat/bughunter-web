#!/bin/sh
set -eu
umask 027
# SSH is optional port forwarding only; absence of public keys never disables the web console.
if [ -f /run/research-keys/authorized_keys ]; then
  install -o root -g root -m 0644 /run/research-keys/authorized_keys /etc/ssh/authorized_keys
else
  install -o root -g root -m 0644 /dev/null /etc/ssh/authorized_keys
fi
if [ ! -f /etc/ssh/host-keys/ssh_host_ed25519_key ]; then
  ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/host-keys/ssh_host_ed25519_key
fi
chmod 0700 /etc/ssh/host-keys
chmod 0600 /etc/ssh/host-keys/ssh_host_ed25519_key
# Aggregate legacy provider volumes stay untouched pending explicit migration.
install -d -o root -g root -m 0711 /var/lib/bughunter-identities /var/lib/bughunter-identities/active /var/lib/bughunter-homes
install -d -o root -g root -m 0711 /run/bughunter-broker
python3 /opt/bughunter/docker/research/broker/broker.py &
broker_pid=$!
# Recreate deterministic non-secret transport settings before any CLI starts.
node --input-type=module -e '
import {writeFileSync} from "node:fs";
const keys = ["BURP_MCP_HOST", "BURP_MCP_PORT", "BURP_PROXY_HOST", "BURP_PROXY_PORT"];
writeFileSync("/etc/bughunter/burp-endpoint.json", JSON.stringify(Object.fromEntries(keys.filter(k => process.env[k]).map(k => [k, process.env[k]]))), {mode: 0o644});'
chmod 0644 /etc/bughunter/burp-endpoint.json
/usr/sbin/sshd -D -e &
sshd_pid=$!
printf '%s\n' "$sshd_pid" > /run/research-sshd.pid
HOME=/home/researcher USER=researcher LOGNAME=researcher CODEX_HOME=/home/researcher/.codex CLAUDE_CONFIG_DIR=/home/researcher/.claude DISABLE_AUTOUPDATER=1 setpriv --reuid=researcher --regid=research --init-groups --no-new-privs node /opt/bughunter/docker/research/console/server.mjs &
console_pid=$!
trap 'kill "$broker_pid" 2>/dev/null || true; setpriv --reuid=researcher --regid=research --init-groups kill "$console_pid" 2>/dev/null || true; kill "$sshd_pid" 2>/dev/null || true; wait || true' TERM INT EXIT
# Failure of either mandatory local process triggers Docker restart, not a silent half-service.
while kill -0 "$broker_pid" 2>/dev/null && kill -0 "$sshd_pid" 2>/dev/null && setpriv --reuid=researcher --regid=research --init-groups kill -0 "$console_pid" 2>/dev/null; do sleep 1; done
exit 1
