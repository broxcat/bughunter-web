// bughunter-web — shared data contract (FROZEN after Phase 0).
// Phase 1 agents MUST NOT edit this file. If a field is missing, request it in
// your final report; the lead adds it once at the end of Phase 1 and re-migrates.
//
// Security invariant encoded here: a Target references a Scope, and the whole
// application refuses to scan unless that Scope.status === APPROVED. This is the
// authorization attestation; it is re-checked in the worker just before any tool runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) standard models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Credentials provider: bcrypt hash. Null for OAuth-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  aiProviderConfig AiProviderConfig[]
  scopes           Scope[]
  targets          Target[]
  reports          Report[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// AI providers — per-user, multi-provider. API key stored encrypted only.
// ---------------------------------------------------------------------------

model AiProviderConfig {
  id           String     @id @default(cuid())
  userId       String
  provider     AiProvider
  // AES-256-GCM ciphertext of the API key. NEVER returned to the client.
  apiKeyCipher String?    @db.Text
  model        String?
  baseUrl      String?
  isActive     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One config per (user, provider).
  @@unique([userId, provider])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Authorization: no scan runs without an APPROVED Scope. Non-negotiable.
// ---------------------------------------------------------------------------

model Scope {
  id            String      @id @default(cuid())
  userId        String
  // e.g. "*.example.com", "api.example.com". Free-form host pattern.
  hostPattern   String
  programName   String?
  // Why the user is authorized to test this (bug bounty program URL, engagement ref...).
  justification String?     @db.Text
  status        ScopeStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Bug bounty program policy (all optional, informational). Mirrors the standard
  // program structure (HackerOne / YesWeHack / Bugcrowd). These are shown during
  // the hunt as a reminder; they do NOT gate scanning — only `status` does.
  platform            ReportPlatform?
  scopeDetails        String?         @db.Text // in-scope assets beyond hostPattern
  outOfScope          String?         @db.Text // excluded assets / vuln classes
  rulesOfEngagement   String?         @db.Text
  vendorResponseSla   String?         @db.Text
  accessInfo          String?         @db.Text // how to get access (invites, test accounts)
  eligibilityCriteria String?         @db.Text
  disclosurePolicy    String?         @db.Text // responsible disclosure policy
  reportingFormat     String?         @db.Text
  rewardsTable        String?         @db.Text
  safeHarbor          String?         @db.Text
  legalTerms          String?         @db.Text
  contactInfo         String?         @db.Text

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets Target[]

  @@index([userId])
  @@index([status])
}

model Target {
  id        String   @id @default(cuid())
  userId    String
  scopeId   String
  // Bare host (no scheme, no path, no trailing slash); may include :port.
  // Unique per user. subfinder/nmap take this (port stripped); httpx/katana/
  // nuclei take scheme://host rebuilt from `scheme`.
  host      String
  // Original scheme ("http"/"https") when the user entered a full URL; null
  // means unspecified and the app falls back to https.
  scheme    String?
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       Scope              @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  scanRuns    ScanRun[]
  findings    Finding[]
  reports     Report[]
  credentials TargetCredential[]

  @@index([userId])
  @@index([scopeId])
}

// ---------------------------------------------------------------------------
// Target credentials — session cookies / bearer token FOR THE SCANNED TARGET
// (a bug-bounty program's app), NEVER the bughunter-web login. They let the
// BOLA/CSRF scanners authenticate as real test accounts on the target. Stored
// encrypted (AES-256-GCM) only, same invariant as AiProviderConfig.apiKeyCipher:
// the cipher is NEVER returned to any client and decryption happens server-side
// in-process at request time. At least one of cookiesCipher/headerCipher must be
// set per row (enforced in the API, not the DB).
model TargetCredential {
  id            String         @id @default(cuid())
  targetId      String
  label         String
  mode          CredentialMode @default(COOKIES)
  cookiesCipher String?        @db.Text // AES-GCM of JSON.stringify(cookies map)
  headerCipher  String?        @db.Text // AES-GCM of a bearer token (Authorization value)
  // EMAIL_PASSWORD mode: the app logs in via headless Chromium to mint/refresh
  // the session cookies automatically. Email/password encrypted like everything else.
  loginUrl             String?   @db.Text
  emailCipher          String?   @db.Text
  passwordCipher       String?   @db.Text
  sessionCookiesCipher String?   @db.Text // cached cookies obtained by auto-login
  sessionRefreshedAt   DateTime? // when the cached session was last minted
  createdAt            DateTime  @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

enum CredentialMode {
  COOKIES
  BEARER
  EMAIL_PASSWORD
}

// ---------------------------------------------------------------------------
// Scan execution
// ---------------------------------------------------------------------------

model ScanRun {
  id         String     @id @default(cuid())
  targetId   String
  type       ScanType
  status     ScanStatus @default(QUEUED)
  // BullMQ job id, set once enqueued.
  jobId      String?
  error      String?    @db.Text
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  target   Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  logs     ScanLog[]
  findings Finding[]

  @@index([targetId])
  @@index([status])
}

// Append-only log lines streamed to the browser over SSE.
model ScanLog {
  id        String     @id @default(cuid())
  scanRunId String
  line      String     @db.Text
  stream    ScanStream @default(STDOUT)
  createdAt DateTime   @default(now())

  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId, createdAt])
}

// ---------------------------------------------------------------------------
// Findings + triage gate
// ---------------------------------------------------------------------------

model Finding {
  id           String     @id @default(cuid())
  targetId     String
  scanRunId    String?
  title        String
  vulnClass    String?
  severity     Severity   @default(INFO)
  description  String?    @db.Text
  // Where the finding was observed: URL, endpoint, or parameter
  // (e.g. "/api/users/{id}", "?redirect="). Optional.
  location     String?
  evidence     String?    @db.Text
  // Confidence axis, INDEPENDENT of severity and gateStatus. PROVEN = direct
  // evidence in the HTTP response/observed behavior; CANDIDATE = needs manual or
  // out-of-band confirmation. A CANDIDATE may still carry a high severity.
  confidence   FindingConfidence? @default(CANDIDATE)
  gateStatus   GateStatus @default(UNVALIDATED)
  // JSON: the 7-Question Gate answers.
  gateAnswers  Json?
  killedReason String?    @db.Text
  // Out-of-band correlation key (Phase 5). The SSRF scanner sets this to the
  // per-attempt token it embedded in a self-hosted OOB callback URL; a matching
  // OobHit.token row (written by the catcher when the target calls back) CONFIRMS
  // blind SSRF. Nullable, no backfill — most findings never use OOB.
  oobToken     String?
  // Industry-standard classification, all optional and complementary to
  // `severity` (which stays the source of truth for badges/filters).
  // cwe: e.g. "CWE-79"; pre-filled from vulnClass at creation, editable.
  cwe          String?
  // CVSS v3.1 base vector, e.g. "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H".
  // cvssScore is always recomputed server-side from the vector.
  cvssVector   String?
  cvssScore    Float?
  // Manually written report sections; the report shows a placeholder when empty.
  impact       String?    @db.Text
  remediation  String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  target      Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  scanRun     ScanRun?     @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  reportItems ReportItem[]

  @@index([targetId])
  @@index([gateStatus])
}

// ---------------------------------------------------------------------------
// Reports — may ONLY contain findings whose gateStatus === PASSED.
// ---------------------------------------------------------------------------

model Report {
  id        String         @id @default(cuid())
  userId    String
  // Optional direct link to the target the report is about. Reports also reach
  // their target via items -> finding -> target; this denormalized FK makes
  // "all reports for this target" a one-hop query.
  targetId  String?
  title     String
  platform  ReportPlatform @default(GENERIC)
  markdown  String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  target Target?      @relation(fields: [targetId], references: [id], onDelete: SetNull)
  items  ReportItem[]

  @@index([userId])
  @@index([targetId])
}

// Join table report <-> finding (PASSED findings only; enforced in the API layer).
model ReportItem {
  id        String @id @default(cuid())
  reportId  String
  findingId String

  report  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([reportId, findingId])
  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Out-of-band interaction catcher (Phase 5)
// ---------------------------------------------------------------------------

// One row per inbound request the self-hosted OOB catcher receives. The SSRF
// scanner embeds a unique `token` in a callback URL; when the scanned target
// fetches that URL, the catcher inserts a row here. The worker CONFIRMS a blind
// finding by reading this table (no worker->catcher HTTP needed — correlation
// is purely via the shared Postgres row). Append-only; never updated.
model OobHit {
  id         String   @id @default(cuid())
  token      String
  receivedAt DateTime @default(now())
  sourceIp   String?
  method     String
  rawHeaders Json?

  @@index([token])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AiProvider {
  OLLAMA
  GROQ
  DEEPSEEK
  ANTHROPIC
  OPENAI
  XAI
  OPENROUTER
  ORCAROUTER
  FLUXION
  LITELLM
  REQUESTY
}

enum ScopeStatus {
  PENDING
  APPROVED
  REVOKED
}

enum ScanType {
  RECON
  HUNT
  VALIDATE
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanStream {
  STDOUT
  STDERR
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GateStatus {
  UNVALIDATED
  PASSED
  KILLED
}

enum FindingConfidence {
  CANDIDATE
  PROVEN
}

enum ReportPlatform {
  HACKERONE
  BUGCROWD
  INTIGRITI
  YESWEHACK
  IMMUNEFI
  GENERIC
}
