generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) standard models
// ---------------------------------------------------------------------------

model User {
  hunterIdentity HunterIdentity?
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Credentials provider: bcrypt hash. Null for OAuth-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bountyPrograms   BountyProgram[]
  accounts         Account[]
  sessions         Session[]
  aiProviderConfig AiProviderConfig[]
  scopes           Scope[]
  targets          Target[]
  reports          Report[]
  scanRequestKeys  ScanRequestKey[]
  researchSessions ResearchSession[]
  researchPromotions ResearchFindingPromotion[]
  researchRouting ResearchModelRouting?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// AI providers — per-user, multi-provider. API key stored encrypted only.
// ---------------------------------------------------------------------------

model AiProviderConfig {
  id           String     @id @default(cuid())
  userId       String
  provider     AiProvider
  // AES-256-GCM ciphertext of the API key. NEVER returned to the client.
  apiKeyCipher String?    @db.Text
  model        String?
  baseUrl      String?
  isActive     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One config per (user, provider).
  @@unique([userId, provider])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Authorization: no scan runs without an APPROVED Scope. Non-negotiable.
// ---------------------------------------------------------------------------

model Scope {
  id            String      @id @default(cuid())
  userId        String
  // e.g. "*.example.com", "api.example.com". Free-form host pattern.
  hostPattern   String
  programName   String?
  // Why the user is authorized to test this (bug bounty program URL, engagement ref...).
  justification String?     @db.Text
  status        ScopeStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Bug bounty program policy (all optional, informational). Mirrors the standard
  // program structure (HackerOne / YesWeHack / Bugcrowd). These are shown during
  // the hunt as a reminder; they do NOT gate scanning — only `status` does.
  platform            ReportPlatform?
  scopeDetails        String?         @db.Text // in-scope assets beyond hostPattern
  outOfScope          String?         @db.Text // excluded assets / vuln classes
  rulesOfEngagement   String?         @db.Text
  vendorResponseSla   String?         @db.Text
  accessInfo          String?         @db.Text // how to get access (invites, test accounts)
  eligibilityCriteria String?         @db.Text
  disclosurePolicy    String?         @db.Text // responsible disclosure policy
  reportingFormat     String?         @db.Text
  rewardsTable        String?         @db.Text
  safeHarbor          String?         @db.Text
  legalTerms          String?         @db.Text
  contactInfo         String?         @db.Text

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets Target[]

  @@index([userId])
  @@index([status])
}

enum BountyPlatform {
  YESWEHACK
  HACKERONE
  INTIGRITI
  BUGCROWD
  OTHER
  PRIVATE
}

// Business Target. Technical Target identities and their historical FKs stay intact.
enum AssessmentMode {
  BLACK_BOX
  WHITE_BOX
}

enum AssessmentSourceKind {
  GIT_REPOSITORY
  SOURCE_ARCHIVE
  API_SPECIFICATION
  ARCHITECTURE_DOCUMENTATION
  CONFIGURATION
  OTHER
}

// Current program context only. Historical Research/Recon snapshots are separate.
model TargetScopeContext {
  programId String @id
  policyFingerprint String
  sourceFingerprint String
  rendererVersion Int
  markdown String @db.Text
  markdownSha256 String
  generatedAt DateTime
  program BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model BountyProgram {
  executionPolicies ProgramExecutionPolicy[]
  currentScopeContext TargetScopeContext?
  researchPlans ResearchPlan[]
  // Legacy enum retained; current programs are constrained to BLACK_BOX.
  assessmentMode AssessmentMode @default(BLACK_BOX)
  assessmentSources AssessmentSource[]
  scopeRules        String[]        @default([])
  rulesOfEngagement String?         @db.Text
  deletingAt        DateTime?
  id                String          @id @default(cuid())
  ownerId           String
  companyName       String
  platform          BountyPlatform?
  programUrl        String?
  rewardCurrency    String          @default("EUR")
  rewardLow         Decimal?        @db.Decimal(18, 2)
  rewardMedium      Decimal?        @db.Decimal(18, 2)
  rewardHigh        Decimal?        @db.Decimal(18, 2)
  rewardCritical    Decimal?        @db.Decimal(18, 2)
  requiredUserAgent String
  outOfScope        String[]        @default([])
  qualifying        String[]        @default([])
  nonQualifying     String[]        @default([])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  targets           Target[]
  scopeAssets       ScopeAsset[]
  reconRuns TargetReconRun[]
  reconSummaries ReconSummary[]

  @@index([ownerId])
}

// Data authorization metadata only. This relation never grants network scope.
model AssessmentSource {
  id String @id @default(cuid())
  programId String
  label String
  kind AssessmentSourceKind
  locator String
  reference String?
  includePaths String[] @default([])
  excludePaths String[] @default([])
  active Boolean @default(false)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@index([programId, active])
}

model Target {
  reconHistory ReconHistoryRun[]
  reconSurfaces ReconSurface[]
  evidenceRecords EvidenceRecord[]

  researchCoverage ResearchCoverage[]

  researchPlans ResearchPlan[]
  consoleDeletingAt DateTime?
  scopeAssetId String? @unique
  scopeAsset ScopeAsset? @relation("AssetExecution", fields: [scopeAssetId], references: [id], onDelete: SetNull)
  discoveredFromAssetId String?
  discoveredFromAsset ScopeAsset? @relation("AssetDiscoveries", fields: [discoveredFromAssetId], references: [id], onDelete: SetNull)
  // Internal program execution/workspace identity; never a discovered host.
  contextOnly Boolean @default(false)
  discoverySource String?
  discoveredAt DateTime?
  discoveredByScanRunId String?
  programId String?
  active    Boolean        @default(true)
  program   BountyProgram? @relation(fields: [programId], references: [id], onDelete: Restrict)

  id        String   @id @default(cuid())
  userId    String
  scopeId   String
  // Bare host (no scheme, no path, no trailing slash); may include :port.
  // Active hosts are unique per program (partial SQL index). nmap takes the
  // host without a port; httpx/katana/
  // nuclei take scheme://host rebuilt from `scheme`.
  host      String
  // Original scheme ("http"/"https") when the user entered a full URL; null
  // means unspecified and the app falls back to https.
  scheme    String?
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       Scope              @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  scanRuns    ScanRun[]
  findings    Finding[]
  reports     Report[]
  credentials TargetCredential[]
  researchSessions ResearchSession[]

  @@index([userId])
  @@index([scopeId])
  @@index([programId, active])
}

// ---------------------------------------------------------------------------
// Target credentials — session cookies / bearer token FOR THE SCANNED TARGET
// (a bug-bounty program's app), NEVER the bughunter-web login. They let the
// BOLA/CSRF scanners authenticate as real test accounts on the target. Stored
// encrypted (AES-256-GCM) only, same invariant as AiProviderConfig.apiKeyCipher:
// the cipher is NEVER returned to any client and decryption happens server-side
// in-process at request time. At least one of cookiesCipher/headerCipher must be
// set per row (enforced in the API, not the DB).
enum CredentialPurpose {
  ACCOUNT_A
  ACCOUNT_B
  SESSION_COOKIE
  JWT
  OTHER
}

model TargetCredential {
  // Operator-declared context; never a verified role or an execution permission.
  persona String?
  reconEnabled Boolean @default(false)
  sessionStatus        TargetSessionStatus @default(UNKNOWN)
  sessionCheckedAt     DateTime?
  sessionExpiresAt     DateTime?
  validationUrl        String? @db.Text
  sessionIdentityHash  String?
  sessionCheckId       String?
  purpose              CredentialPurpose @default(OTHER)
  // Explicit user attestation: a read-only object owned by this test account.
  ownedObjectUrl       String?
  id                   String            @id @default(cuid())
  targetId             String
  label                String
  mode                 CredentialMode    @default(COOKIES)
  cookiesCipher        String?           @db.Text // AES-GCM of JSON.stringify(cookies map)
  headerCipher         String?           @db.Text // AES-GCM of a bearer token (Authorization value)
  // EMAIL_PASSWORD mode: the app logs in via headless Chromium to mint/refresh
  // the session cookies automatically. Email/password encrypted like everything else.
  loginUrl             String?           @db.Text
  emailCipher          String?           @db.Text
  passwordCipher       String?           @db.Text
  sessionCookiesCipher String?           @db.Text // cached cookies obtained by auto-login
  sessionRefreshedAt   DateTime? // when the cached session was last minted
  createdAt            DateTime          @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

enum TargetSessionStatus {
  VALID
  INVALID
  EXPIRED
  UNKNOWN
}

enum CredentialMode {
  COOKIES
  BEARER
  EMAIL_PASSWORD
}

// ---------------------------------------------------------------------------
// Scan execution
// ---------------------------------------------------------------------------

model ScanRun {
  surfaceHistory ReconHistoryRun?
  researchPlans ResearchPlan[]
  authenticatedContextsSnapshot Json?
  authenticatedReconResult Json?
  surfaceObservations ReconSurfaceObservation[]
  // Null means historical mode was not captured; never infer from today's program.
  assessmentModeSnapshot AssessmentMode?
  assessmentSourcesSnapshot Json?
  reconSummaries ReconSummary[]
  targetReconRunId String?
  targetReconRun TargetReconRun? @relation(fields: [targetReconRunId], references: [id], onDelete: SetNull)
  reconOrder Int @default(0)
  reconPlan Json?
  toolVersions Json?
  toolManifest Json?
  artifactVersion Int @default(0)
  artifacts ReconArtifact[]
  changeSet Json?
  scopeMarkdown String? @db.Text
  scopeMarkdownSha256 String?
  scopeAssetId String?
  scopeAsset ScopeAsset? @relation(fields: [scopeAssetId], references: [id], onDelete: SetNull)
  scopeAssetSnapshot Json?
  assetResults Json?
  reconSteps ReconPipelineStep[]
  discoveries HostDiscovery[]
  approvedHuntTechniques String[]   @default([])
  huntReport             Json?
  reconCorpus            Json?
  // Immutable execution-time Hunt policy; legacy runs remain unknown.
  huntSnapshot           Json?
  // Effective execution-time configuration, never changed by later program edits.
  requiredUserAgent      String?
  id                     String     @id @default(cuid())
  targetId               String
  type                   ScanType
  status                 ScanStatus @default(QUEUED)
  // Execution result; null for live jobs and historical runs of unknown outcome.
  outcome                ScanOutcome?
  // BullMQ job id, set once enqueued.
  jobId                  String?
  error                  String?    @db.Text
  createdAt              DateTime   @default(now())
  startedAt              DateTime?
  finishedAt             DateTime?
  cancelRequestedAt      DateTime?

  target   Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  logs     ScanLog[]
  findings Finding[]
  jobOutbox ScanJobOutbox?
  requestKey ScanRequestKey?
  executionAttempts ScanExecutionAttempt[]
  researchSessions ResearchSession[]

  @@index([targetId])
  @@index([scopeAssetId, createdAt])
  @@index([targetReconRunId])
  @@index([status])
}

model HostDiscovery {
  id String @id @default(cuid())
  scanRunId String
  host String
  source String
  state String
  added Boolean @default(false)
  createdAt DateTime @default(now())
  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  @@unique([scanRunId, host])
}

// Real starts only: historical scans have no invented execution attempts.
model ScanExecutionAttempt {
  cleanupConfirmedAt DateTime?
  id               String                    @id @default(cuid())
  scanRunId        String
  workerId         String
  state            ScanExecutionAttemptState @default(RUNNING)
  startedAt        DateTime                  @default(now())
  heartbeatAt      DateTime                  @default(now())
  finishedAt       DateTime?
  networkStartedAt DateTime?
  usefulWorkAt     DateTime?
  reason           String?                   @db.Text
  scanRun          ScanRun                   @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId])
  @@index([state, heartbeatAt])
}

enum ScanExecutionAttemptState {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

// Durable publication intent. Redis failures never change ScanStatus/ScanOutcome.
model ScanJobOutbox {
  id            String                @id @default(cuid())
  scanRunId     String                @unique
  status        ScanJobDispatchStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?               @db.Text
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scanRun       ScanRun               @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

// Optional HTTP idempotence, scoped to the requesting user, enforced in SQL.
model ScanRequestKey {
  userId      String
  key         String
  requestHash String
  scanRunId   String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanRun     ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

enum ScanJobDispatchStatus {
  PENDING
  PUBLISHED
}

// Append-only log lines streamed to the browser over SSE.
model ScanLog {
  id        String     @id @default(cuid())
  scanRunId String
  line      String     @db.Text
  stream    ScanStream @default(STDOUT)
  createdAt DateTime   @default(now())

  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId, createdAt])
}

// ---------------------------------------------------------------------------
// Findings + triage gate
// ---------------------------------------------------------------------------

model Finding {
  // Null on historical rows: no invented lifecycle or past validation.
  lifecycle FindingLifecycle? @default(CANDIDATE)
  lifecycleRevision Int @default(0)
  submission Json?
  lifecycleEvents FindingLifecycleEvent[]
  retests FindingRetest[]

  vaultEvidence EvidenceFinding[]

  reviewStatus FindingReviewStatus @default(CANDIDATE)
  reviewEvidence Json?
  reviewedAt DateTime?
  huntMetadata Json?
  id           String             @id @default(cuid())
  targetId     String
  scanRunId    String?
  title        String
  vulnClass    String?
  severity     Severity           @default(INFO)
  description  String?            @db.Text
  // Where the finding was observed: URL, endpoint, or parameter
  // (e.g. "/api/users/{id}", "?redirect="). Optional.
  location     String?
  evidence     String?            @db.Text
  // Confidence axis, INDEPENDENT of severity and gateStatus. PROVEN = direct
  // evidence in the HTTP response/observed behavior; CANDIDATE = needs manual or
  // out-of-band confirmation. A CANDIDATE may still carry a high severity.
  confidence   FindingConfidence? @default(CANDIDATE)
  gateStatus   GateStatus         @default(UNVALIDATED)
  // Historical validation columns retained for migration compatibility only.
  gateAnswers  Json?
  killedReason String?            @db.Text
  // Out-of-band correlation key (Phase 5). The SSRF scanner sets this to the
  // per-attempt token it embedded in a self-hosted OOB callback URL; a matching
  // OobHit.token row (written by the catcher when the target calls back) CONFIRMS
  // blind SSRF. Nullable, no backfill — most findings never use OOB.
  oobToken     String?
  // Industry-standard classification, all optional and complementary to
  // `severity` (which stays the source of truth for badges/filters).
  // cwe: e.g. "CWE-79"; pre-filled from vulnClass at creation, editable.
  cwe          String?
  // CVSS v3.1 base vector, e.g. "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H".
  // cvssScore is always recomputed server-side from the vector.
  cvssVector   String?
  cvssScore    Float?
  // Manually written report sections; the report shows a placeholder when empty.
  impact       String?            @db.Text
  remediation  String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  target      Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  scanRun     ScanRun?     @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  reportItems ReportItem[]
  researchPromotion ResearchFindingPromotion?

  @@index([targetId])
  @@index([gateStatus])
}

enum FindingReviewStatus {
  CANDIDATE
  EVIDENCE_REVIEW
  CONFIRMED
  REJECTED
  INCONCLUSIVE
}

// ---------------------------------------------------------------------------
// Reports — may ONLY contain findings whose gateStatus === PASSED.
// ---------------------------------------------------------------------------

model Report {
  vaultEvidence EvidenceReport[]

  id        String         @id @default(cuid())
  userId    String
  // Optional direct link to the target the report is about. Reports also reach
  // their target via items -> finding -> target; this denormalized FK makes
  // "all reports for this target" a one-hop query.
  targetId  String?
  title     String
  platform  ReportPlatform @default(GENERIC)
  markdown  String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  target Target?      @relation(fields: [targetId], references: [id], onDelete: SetNull)
  items  ReportItem[]

  @@index([userId])
  @@index([targetId])
}

// Join table report <-> finding (PASSED findings only; enforced in the API layer).
model ReportItem {
  id        String @id @default(cuid())
  reportId  String
  findingId String

  report  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([reportId, findingId])
  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Out-of-band interaction catcher (Phase 5)
// ---------------------------------------------------------------------------

// One row per inbound request the self-hosted OOB catcher receives. The SSRF
// scanner embeds a unique `token` in a callback URL; when the scanned target
// fetches that URL, the catcher inserts a row here. The worker CONFIRMS a blind
// finding by reading this table (no worker->catcher HTTP needed — correlation
// is purely via the shared Postgres row). Append-only; never updated.
model OobHit {
  id         String   @id @default(cuid())
  token      String
  receivedAt DateTime @default(now())
  sourceIp   String?
  method     String
  rawHeaders Json?

  @@index([token])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AiProvider {
  OLLAMA
  GROQ
  DEEPSEEK
  ANTHROPIC
  OPENAI
  XAI
  OPENROUTER
  ORCAROUTER
  FLUXION
  LITELLM
  REQUESTY
}

enum ScopeStatus {
  PENDING
  APPROVED
  REVOKED
}

enum ScanType {
  RECON
  HUNT      // Legacy: read-only, execution retired
  VALIDATE
}

enum ScanOutcome {
  SUCCESS
  PARTIAL
  FAILED
  UNSUPPORTED
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanStream {
  STDOUT
  STDERR
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GateStatus {
  UNVALIDATED
  PASSED
  KILLED
}

enum FindingConfidence {
  CANDIDATE
  PROVEN
}

enum ReportPlatform {
  HACKERONE
  BUGCROWD
  INTIGRITI
  YESWEHACK
  IMMUNEFI
  GENERIC
}

// Research is a local workspace, never a BullMQ scan or automatic Finding.
enum ResearchSessionStatus {
  CREATING
  READY
  ARCHIVED
  FAILED
}

model ResearchSession {
  // Trusted hashes for CREATING recovery; never authorization from filesystem.
  publicationManifest Json?
  evidenceRecords EvidenceRecord[]

  coverageEvents ResearchCoverageEvent[]

  researchPlanId String?
  researchPlan ResearchPlan? @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  id             String @id @default(cuid())
  userId         String
  targetId       String
  workspaceId    String @unique
  // Null for historical UUID sessions. One persistent console per technical Target.
  consoleTargetId String? @unique
  // Selected console; native conversations remain separate for each provider.
  provider       ResearchProvider @default(codex)
  reconScanRunId String?
  status         ResearchSessionStatus @default(CREATING)
  targetHost     String
  programName    String
  scopeMarkdown  String @db.Text
  files          String[] @default([])
  exportSha256   String?
  authorizationSnapshot Json?
  hypothesesSyncedAt DateTime?
  hypothesesSourceSha256 String?
  hypotheses ResearchHypothesis[]
  reconSnapshots ResearchReconSnapshot[]
  reconDeliveries ResearchReconDelivery[]
  harnessRuns ResearchHarnessRun[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  target Target @relation(fields: [targetId], references: [id], onDelete: Restrict)
  recon  ScanRun? @relation(fields: [reconScanRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([targetId])
  @@index([reconScanRunId])
}

// CONFIRMED here is technical research evidence, never Finding review/report acceptance.
enum ResearchHypothesisStatus {
  OPEN
  TESTING
  BLOCKED
  REJECTED
  CONFIRMED
}

enum ResearchHypothesisConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ResearchHypothesisSource {
  CODEX_WORKSPACE
}

enum ResearchHypothesisRevisionSource {
  WORKSPACE_IMPORT
}

model ResearchHypothesis {
  vaultEvidence EvidenceHypothesis[]

  planItemId String?
  planItem ResearchPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  id                     String @id @default(cuid())
  sessionId              String
  externalId             String
  title                  String @db.VarChar(200)
  status                 ResearchHypothesisStatus
  hypothesis             String @db.Text
  evidenceFor            Json
  evidenceAgainst        Json
  nextTest               String @db.Text
  expectedSignal         String @db.Text
  falsificationCondition String @db.Text
  blockedReason          String? @db.Text
  notes                  String? @db.Text
  confidence             ResearchHypothesisConfidence?
  tags                   String[] @default([])
  source                 ResearchHypothesisSource @default(CODEX_WORKSPACE)
  sourceUpdatedAt        DateTime?
  importedAt             DateTime @default(now())
  researchData           Json?
  contentSha256          String
  revision               Int @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  revisions ResearchHypothesisRevision[]
  promotion ResearchFindingPromotion?

  @@unique([sessionId, externalId])
  @@index([planItemId])
  @@index([sessionId, status])
}

// Append-only through the import service. No mutation API or inline UI editing.
model ResearchHypothesisRevision {
  id           String @id @default(cuid())
  hypothesisId String
  revision     Int
  snapshot     Json
  humanReview  Json?
  source       ResearchHypothesisRevisionSource @default(WORKSPACE_IMPORT)
  createdAt    DateTime @default(now())

  hypothesis ResearchHypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)

  @@unique([hypothesisId, revision])
}

// Explicit human action only. Unique keys make retries/concurrency idempotent.
// Retain promoted Research provenance rather than cascade-delete its history.
model ResearchFindingPromotion {
  id                 String @id @default(cuid())
  hypothesisId       String @unique
  findingId          String @unique
  userId             String
  hypothesisRevision Int
  snapshot           Json
  createdAt          DateTime @default(now())

  hypothesis ResearchHypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Restrict)
  finding    Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

enum ResearchProvider {
  codex
  claude
}

// Derived, immutable evidence. Original ScanRun/HostDiscovery/ScanLog stay authoritative.
model ResearchReconSnapshot {
  researchPlanId String?
  researchPlan ResearchPlan? @relation(fields: [researchPlanId], references: [id], onDelete: SetNull)
  id String @id @default(cuid())
  sessionId String
  sourceFingerprint String
  contentSha256 String
  summarySha256 String
  context Json
  summary Json
  createdAt DateTime @default(now())
  session ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveries ResearchReconDelivery[]

  @@unique([sessionId, sourceFingerprint])
  @@index([sessionId, createdAt])
}

enum ScopeAssetFormat {
  URL
  WILDCARD_DOMAIN
  DOMAIN
  SUBDOMAIN
  HOSTNAME
  IP
  CIDR
}
enum ScopeAssetType {
  API
  WEB_APPLICATION
  WILDCARD
  OTHER
}
enum AssetValue {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}
model ScopeAsset {
  researchCoverage ResearchCoverage[]

  researchPlans ResearchPlan[]
  surfaceObservations ReconSurfaceObservation[]
  id String @id @default(cuid())
  programId String
  originalValue String
  normalizedValue String
  formatSource String @default("AUTO")
  format ScopeAssetFormat
  type ScopeAssetType
  typeSource String @default("HEURISTIC")
  assetValue AssetValue @default(MEDIUM)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  executionTarget Target? @relation("AssetExecution")
  discoveredTargets Target[] @relation("AssetDiscoveries")
  scanRuns ScanRun[]
  artifacts ReconArtifact[]
  reconSummaries ReconSummary[]
  @@unique([programId, normalizedValue])
  @@index([programId, active])
}
enum ReconPipelineState {
  COMPLETED_WITH_FALLBACK
  SKIPPED_NOT_APPLICABLE
  SKIPPED_UNSUPPORTED
  CANCELLED
  PARTIAL
  BLOCKED
  PENDING
  RUNNING
  COMPLETED
  SKIPPED
  FAILED
}
model ReconPipelineStep {
  capability String?
  details Json?
  id String @id @default(cuid())
  scanRunId String
  name String
  position Int
  state ReconPipelineState @default(PENDING)
  reason String?
  startedAt DateTime?
  finishedAt DateTime?
  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  @@unique([scanRunId, name])
}

// Delivery means a message was staged for the operator, never that an LLM consumed it.
model ResearchReconDelivery {
  id String @id @default(cuid())
  sessionId String
  snapshotId String
  provider ResearchProvider
  status String @default("PENDING")
  createdAt DateTime @default(now())
  session ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  snapshot ResearchReconSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Parent execution contains immutable child membership, not another scan engine.
model TargetReconRun {
  assessmentModeSnapshot AssessmentMode?
  assessmentSourcesSnapshot Json?
  reconSummaries ReconSummary[]
  id String @id @default(cuid())
  programId String
  program BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  status ScanStatus @default(QUEUED)
  outcome ScanOutcome?
  preflight Json?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  cancelRequestedAt DateTime?
  scopeMarkdown String? @db.Text
  scopeMarkdownSha256 String?
  scans ScanRun[]
  @@index([programId, createdAt])
}

model ReconArtifact {
  vaultRecords EvidenceRecord[]

  id String @id @default(cuid())
  scanRunId String
  scopeAssetId String
  kind String
  canonicalKey String
  value Json
  scopeState String
  verification String
  sources Json
  firstSeenAt DateTime
  lastSeenAt DateTime
  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  scopeAsset ScopeAsset @relation(fields: [scopeAssetId], references: [id], onDelete: Cascade)
  @@unique([scanRunId, kind, canonicalKey])
  @@index([scopeAssetId, kind])
}

// How an endpoint was observed in one context; no raw bodies or credentials.
model ReconSurfaceObservation {
  id String @id @default(cuid())
  scanRunId String
  scopeAssetId String
  contextKey String
  contextType String
  canonicalKey String
  url String @db.Text
  urlRedacted Boolean @default(false)
  method String
  statusCode Int?
  contentType String?
  redirect String? @db.Text
  redirectPattern String? @db.Text
  bodyHash String?
  bodyLength Int?
  responseClass String
  observedAt DateTime @default(now())
  source String
  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  scopeAsset ScopeAsset @relation(fields: [scopeAssetId], references: [id], onDelete: Cascade)
  @@unique([scanRunId, contextKey, canonicalKey])
  @@index([scanRunId])
  @@index([scopeAssetId])
}

// Durable post-Recon tasks; never an investigation provider or source of facts.
model ReconSummary {
  id String @id @default(cuid())
  provider AiProvider @default(OLLAMA)
  programId String
  scopeAssetId String?
  scanRunId String?
  targetReconRunId String?
  automaticKey String? @unique
  status String @default("PENDING")
  model String
  endpoint String
  promptVersion String
  sourceFingerprint String
  input Json
  content Json?
  error String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  generatedAt DateTime?
  program BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  scopeAsset ScopeAsset? @relation(fields: [scopeAssetId], references: [id], onDelete: Cascade)
  scanRun ScanRun? @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  targetReconRun TargetReconRun? @relation(fields: [targetReconRunId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([programId, createdAt])
  @@index([scopeAssetId, createdAt])
}

// Advisory objectives derived only from immutable runtime Recon evidence.
enum ResearchPlanStatus {
  CURRENT
  SUPERSEDED
  STALE
}
enum ResearchPlanPriority {
  HIGH
  MEDIUM
  LOW
}
enum ResearchPlanCategory {
  AUTHORIZATION
  AUTHENTICATION
  SESSION_MANAGEMENT
  API
  API_VERSIONING
  GRAPHQL
  FILE_UPLOAD
  SERVER_SIDE_REQUEST
  REDIRECT_HANDLING
  BUSINESS_LOGIC
  PRIVILEGED_FUNCTIONS
  ACCOUNT_LIFECYCLE
  TENANT_ISOLATION
  INPUT_HANDLING
}
enum ResearchPlanItemStatus {
  READY
  NOT_APPLICABLE_BY_PROGRAM
}
model ResearchPlan {
  id String @id @default(cuid())
  targetId String
  programId String
  scopeAssetId String?
  scanRunId String
  sourceFingerprint String
  methodologyVersion String
  assessmentMode AssessmentMode?
  status ResearchPlanStatus @default(CURRENT)
  metadata Json
  createdAt DateTime @default(now())
  supersededAt DateTime?
  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  program BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  scopeAsset ScopeAsset? @relation(fields: [scopeAssetId], references: [id], onDelete: SetNull)
  scanRun ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  items ResearchPlanItem[]
  sessions ResearchSession[]
  reconSnapshots ResearchReconSnapshot[]
  @@unique([targetId, sourceFingerprint])
  @@index([targetId, createdAt])
  @@index([programId])
  @@index([scanRunId])
}
model ResearchPlanItem {
  researchCoverage ResearchCoverage[]

  id String @id @default(cuid())
  planId String
  stableKey String
  category ResearchPlanCategory
  priority ResearchPlanPriority
  title String
  objective String @db.Text
  rationale String @db.Text
  methodology String @db.Text
  surfaceRefs Json
  evidenceRefs Json
  contextRefs Json
  runtimeSignals Json
  sourceSignals Json
  sourceEvidenceRefs Json
  score Int
  evidenceStrength Int
  status ResearchPlanItemStatus @default(READY)
  isNew Boolean @default(true)
  createdAt DateTime @default(now())
  plan ResearchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  hypotheses ResearchHypothesis[]
  @@unique([planId, stableKey])
  @@index([planId, priority])
}

// Target-owned memory survives session closure and console deletion.
// States record bounded tests, never safety or automatic Finding promotion.
enum ResearchCoverageState {
  NOT_TESTED
  IN_PROGRESS
  COVERED_NO_ISSUE_OBSERVED
  INTERESTING
  BLOCKED
  HYPOTHESIS_OPEN
  FINDING
  NEEDS_RETEST
}
model ResearchCoverage {
  scopeAssetReferenceId String?
  planItemReferenceId String
  id String @id @default(cuid())
  targetId String
  scopeAssetId String?
  planItemId String?
  objectiveKey String
  coverageKey String
  category String
  surface String
  method String
  contextKey String
  contextLabel String
  comparisonKey String?
  comparisonLabel String?
  contextRunId String
  testKey String
  revision Int @default(0)
  state ResearchCoverageState @default(NOT_TESTED)
  createdAt DateTime @default(now())
  target Target @relation(fields:[targetId],references:[id],onDelete:Cascade)
  scopeAsset ScopeAsset? @relation(fields:[scopeAssetId],references:[id],onDelete:SetNull)
  planItem ResearchPlanItem? @relation(fields:[planItemId],references:[id],onDelete:SetNull)
  events ResearchCoverageEvent[]
  @@unique([targetId,coverageKey])
  @@index([targetId,objectiveKey])
}
// Append-only revisions. Session reference and plan identity survive FK deletion.
model ResearchCoverageEvent {
  vaultEvidence EvidenceCoverage[]

  id String @id @default(cuid())
  coverageId String
  targetId String
  eventKey String
  contentSha256 String
  revision Int
  state ResearchCoverageState
  action String @db.Text
  result String @db.Text
  evidence Json
  performedAt DateTime
  createdAt DateTime @default(now())
  actorId String
  source String
  sessionId String?
  sessionReferenceId String
  hypothesisReferenceId String?
  hypothesisTestId String?
  findingReferenceId String?
  coverage ResearchCoverage @relation(fields:[coverageId],references:[id],onDelete:Cascade)
  session ResearchSession? @relation(fields:[sessionId],references:[id],onDelete:SetNull)
  @@unique([targetId,eventKey])
  @@unique([coverageId,revision])
  @@index([coverageId,createdAt])
}

enum EvidenceKind {
 HTTP_REQUEST_RESPONSE
 RECON_ARTIFACT
 BURP_REFERENCE
 RESEARCH_EVIDENCE
}
enum EvidenceRelationRole {
 SUPPORTS
 REFUTES
 CONTEXT
}
model EvidenceRecord {
 id String @id
 targetId String
 sessionId String?
 sessionReferenceId String?
 kind EvidenceKind
 sourceKey String
 description String
 provenance Json
 redactionStatus String
 contentSha256 String?
 metadata Json
 reconArtifactId String?
 reconArtifactReferenceId String?
 createdAt DateTime @default(now())
 target Target @relation(fields:[targetId],references:[id],onDelete:Cascade)
 session ResearchSession? @relation(fields:[sessionId],references:[id],onDelete:SetNull)
 reconArtifact ReconArtifact? @relation(fields:[reconArtifactId],references:[id],onDelete:SetNull)
 hypotheses EvidenceHypothesis[]
 findings EvidenceFinding[]
 reports EvidenceReport[]
 coverage EvidenceCoverage[]
 @@unique([targetId,sourceKey])
 @@index([targetId,createdAt])
}
model EvidenceHypothesis {
 id String @id @default(cuid())
 evidenceId String
 hypothesisId String?
 hypothesisReferenceId String
 revision Int
 role EvidenceRelationRole
 createdAt DateTime @default(now())
 evidence EvidenceRecord @relation(fields:[evidenceId],references:[id],onDelete:Cascade)
 hypothesis ResearchHypothesis? @relation(fields:[hypothesisId],references:[id],onDelete:SetNull)
 @@unique([evidenceId,hypothesisReferenceId,revision,role])
 @@index([hypothesisId])
}
model EvidenceFinding {
 id String @id @default(cuid())
 evidenceId String
 findingId String?
 findingReferenceId String
 role EvidenceRelationRole
 createdAt DateTime @default(now())
 evidence EvidenceRecord @relation(fields:[evidenceId],references:[id],onDelete:Cascade)
 finding Finding? @relation(fields:[findingId],references:[id],onDelete:SetNull)
 @@unique([evidenceId,findingReferenceId,role])
 @@index([findingId])
}
model EvidenceReport {
 id String @id @default(cuid())
 evidenceId String
 reportId String?
 reportReferenceId String
 createdAt DateTime @default(now())
 evidence EvidenceRecord @relation(fields:[evidenceId],references:[id],onDelete:Cascade)
 report Report? @relation(fields:[reportId],references:[id],onDelete:SetNull)
 @@unique([evidenceId,reportReferenceId])
 @@index([reportId])
}
model EvidenceCoverage {
 id String @id @default(cuid())
 evidenceId String
 coverageEventId String
 createdAt DateTime @default(now())
 evidence EvidenceRecord @relation(fields:[evidenceId],references:[id],onDelete:Cascade)
 coverageEvent ResearchCoverageEvent @relation(fields:[coverageEventId],references:[id],onDelete:Cascade)
 @@unique([evidenceId,coverageEventId])
 @@index([coverageEventId])
}

// Durable documentary surface identities; never a Scope authorization source.
model ReconHistoryRun {
 id String @id @default(cuid())
 targetId String
 scopeAssetReferenceId String
 scanRunId String? @unique
 scanReferenceId String @unique
 runCreatedAt DateTime
 outcome String
 truncated Boolean @default(false)
 target Target @relation(fields:[targetId],references:[id],onDelete:Cascade)
 scanRun ScanRun? @relation(fields:[scanRunId],references:[id],onDelete:SetNull)
 observations ReconSurfaceSeen[]
 @@index([targetId,scopeAssetReferenceId,runCreatedAt])
}
model ReconSurface {
 id String @id
 targetId String
 scopeAssetReferenceId String
 kind String
 identity String @db.Text
 label String @db.Text
 firstSeenAt DateTime
 lastSeenAt DateTime
 target Target @relation(fields:[targetId],references:[id],onDelete:Cascade)
 observations ReconSurfaceSeen[]
 @@index([targetId,scopeAssetReferenceId])
}
model ReconSurfaceSeen {
 id String @id @default(cuid())
 surfaceId String
 historyId String
 fingerprint String
 details Json
 sourceRefs String[]
 surface ReconSurface @relation(fields:[surfaceId],references:[id],onDelete:Cascade)
 history ReconHistoryRun @relation(fields:[historyId],references:[id],onDelete:Cascade)
 @@unique([historyId,surfaceId])
 @@index([surfaceId])
}

enum FindingLifecycle {
 CANDIDATE
 VALIDATING
 VALIDATED
 REJECTED
 READY_TO_SUBMIT
 SUBMITTED
 TRIAGED
 ACCEPTED
 DUPLICATE
 INFORMATIVE
 NOT_APPLICABLE
 RESOLVED
 RETEST_REQUIRED
 CLOSED
}
enum RetestOutcome {
 FIX_CONFIRMED
 STILL_REPRODUCIBLE
 PARTIALLY_FIXED
 CANNOT_RETEST
}
// Append-only decisions. Evidence review remains an independent required gate.
model FindingLifecycleEvent {
 id String @id @default(cuid())
 findingId String
 revision Int
 eventKey String
 contentSha256 String
 previous FindingLifecycle?
 state FindingLifecycle
 actorId String
 reason String @db.Text
 validation Json?
 submission Json?
 createdAt DateTime @default(now())
 finding Finding @relation(fields:[findingId],references:[id],onDelete:Cascade)
 @@unique([findingId,revision])
 @@unique([findingId,eventKey])
}
model FindingRetest {
 id String @id @default(cuid())
 findingId String
 requestedBy String
 reason String @db.Text
 originalEvidenceIds String[]
 createdAt DateTime @default(now())
 finding Finding @relation(fields:[findingId],references:[id],onDelete:Cascade)
 result FindingRetestResult?
 @@index([findingId,createdAt])
}
// A completed retest is never edited or substituted for the original proof.
model FindingRetestResult {
 id String @id @default(cuid())
 retestId String @unique
 outcome RetestOutcome
 actorId String
 sessionReferenceId String?
 performedAt DateTime
 conclusion String @db.Text
 evidenceIds String[]
 createdAt DateTime @default(now())
 retest FindingRetest @relation(fields:[retestId],references:[id],onDelete:Cascade)
}

model ResearchModelRouting {
  userId String @id
  fastProvider AiProvider?
  fastModel String? @db.VarChar(200)
  reviewProvider AiProvider?
  reviewModel String? @db.VarChar(200)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResearchHarnessRun {
  id String @id @default(cuid())
  sessionId String
  requestKey String @db.Uuid
  stage String
  subject String
  status String
  provider AiProvider
  model String @db.VarChar(200)
  result Json?
  createdAt DateTime @default(now())
  session ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, requestKey])
  @@index([sessionId, stage, subject, createdAt])
}

model ProgramExecutionPolicy {
  programId String
  version   Int
  policy    Json
  createdAt DateTime @default(now())
  program   BountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([programId, version])
}

model HunterIdentity {
  userId    String @id
  userAgent String?
  headers   Json
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
